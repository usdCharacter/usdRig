# Type and op libraries, and the generated registration tables.
#
#   rigexec_add_type_library(name SOURCES ... [REQUIRES lib ...])
#   rigexec_add_op_library(name SOURCES ... [USES_TYPE_LIBRARIES lib ...])
#   rigexec_link_registrations(target [TYPE_LIBRARIES ...] [OP_LIBRARIES ...])
#
# Each library defines RIGEXEC_TYPE_LIBRARY_ENTRY(<target>) or
# RIGEXEC_OP_LIBRARY_ENTRY(<target>). rigexec_link_registrations generates
# rigExec::RigExecLinkedRegistrations() into the target, always, even when
# both lists are empty. Libraries are listed in freeze order.

function(rigexec_add_type_library name)
    cmake_parse_arguments(ARG "" "" "SOURCES;REQUIRES" ${ARGN})
    add_library(${name} STATIC ${ARG_SOURCES})
    target_compile_features(${name} PUBLIC cxx_std_17)
    target_include_directories(${name} PUBLIC
        "$<BUILD_INTERFACE:${PROJECT_SOURCE_DIR}/libs>")
    target_link_libraries(${name} PUBLIC rigExecOpCore)
    if (ARG_REQUIRES)
        target_link_libraries(${name} PUBLIC ${ARG_REQUIRES})
    endif()
    set_target_properties(${name} PROPERTIES POSITION_INDEPENDENT_CODE ON)
endfunction()

function(rigexec_add_op_library name)
    cmake_parse_arguments(ARG "" "" "SOURCES;USES_TYPE_LIBRARIES" ${ARGN})
    add_library(${name} STATIC ${ARG_SOURCES})
    target_compile_features(${name} PUBLIC cxx_std_17)
    target_include_directories(${name} PUBLIC
        "$<BUILD_INTERFACE:${PROJECT_SOURCE_DIR}/libs>")
    target_link_libraries(${name} PUBLIC rigExecOpCore)
    if (ARG_USES_TYPE_LIBRARIES)
        target_link_libraries(${name} PUBLIC ${ARG_USES_TYPE_LIBRARIES})
    endif()
    set_target_properties(${name} PROPERTIES POSITION_INDEPENDENT_CODE ON)
endfunction()

function(rigexec_link_registrations target)
    cmake_parse_arguments(ARG "" "" "TYPE_LIBRARIES;OP_LIBRARIES" ${ARGN})
    set(decls "")
    set(types "")
    set(ops "")
    foreach(lib IN LISTS ARG_TYPE_LIBRARIES)
        string(APPEND decls "RIGEXEC_TYPE_LIBRARY_ENTRY(${lib});\n")
        string(APPEND types "    init.typeLibraries.push_back(${lib}_RigExecTypeLibrary());\n")
    endforeach()
    foreach(lib IN LISTS ARG_OP_LIBRARIES)
        string(APPEND decls "RIGEXEC_OP_LIBRARY_ENTRY(${lib});\n")
        string(APPEND ops "    init.opLibraries.push_back(${lib}_RigExecOpLibrary());\n")
    endforeach()
    set(out "${CMAKE_CURRENT_BINARY_DIR}/rigexec_registrations/${target}.cpp")
    file(GENERATE OUTPUT "${out}" CONTENT
"// Generated by rigexec_link_registrations. Do not edit.
#include \"rigExec/api/registry.h\"

${decls}
namespace rigExec {

RigExecRegistryInit
RigExecLinkedRegistrations()
{
    RigExecRegistryInit init;
${types}${ops}    return init;
}

} // namespace rigExec
")
    target_sources(${target} PRIVATE "${out}")
    if (ARG_TYPE_LIBRARIES OR ARG_OP_LIBRARIES)
        target_link_libraries(${target} PRIVATE
            ${ARG_TYPE_LIBRARIES} ${ARG_OP_LIBRARIES})
    endif()
endfunction()
