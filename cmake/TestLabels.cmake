# Labels for ctest -L. Register tests with rigexec_add_test, which records the
# test's executable; rigexec_label_tests then reads it, because CMake exposes
# no readable COMMAND property for a test. Call it after the last registration.
# usd-free: link closure has no OpenUSD library, and the test does not
# require a fixture another test produces.
# fast: usd-free, or a test whose direct project library is only rigExecMath.
# Each directly linked project library is also a label.
# variant: the same suite rerun under another schedule, environment or driver
# (Serial, FineClusters, Graph_*, _serial/_parallel, DigestGate, ScopedClears,
# Python). `ctest -LE variant` is the quick tier; the whole suite runs all.

# rigexec_add_test(NAME <name> COMMAND <exe-or-target> [args...] [add_test keywords])
# calls add_test with the same arguments. Only a COMMAND that names a target,
# directly or as $<TARGET_FILE:target>, is labelled.
function(rigexec_add_test)
    set(_exe "")
    set(_name "")
    set(_i 0)
    while(_i LESS ARGC)
        if("${ARGV${_i}}" STREQUAL "NAME")
            math(EXPR _j "${_i} + 1")
            set(_name "${ARGV${_j}}")
        elseif("${ARGV${_i}}" STREQUAL "COMMAND")
            math(EXPR _j "${_i} + 1")
            if(_j LESS ARGC)
                set(_exe "${ARGV${_j}}")
            endif()
        endif()
        math(EXPR _i "${_i} + 1")
    endwhile()
    if(NOT _name)
        message(FATAL_ERROR "rigexec_add_test: NAME is required")
    endif()
    if(_exe MATCHES "^\\$<TARGET_FILE:([^>]+)>$")
        set(_exe "${CMAKE_MATCH_1}")
    endif()
    set_property(GLOBAL PROPERTY "RIGEXEC_TEST_EXE:${_name}" "${_exe}")

    set(_code "add_test(")
    math(EXPR _last "${ARGC} - 1")
    foreach(_k RANGE ${_last})
        string(APPEND _code " [==[${ARGV${_k}}]==]")
    endforeach()
    string(APPEND _code ")")
    cmake_language(EVAL CODE "${_code}")
endfunction()

set(_rigexec_pxr_libs
    arch tf gf vt sdf ts usd usdGeom plug work hd usdImaging usdUtils hio sdr js trace pcp usdShade usdLux
    usdRender usdVol usdMedia usdPhysics cameraUtil pxOsd geomUtil glf garch hf
    usdImagingGL)
# The four rigExec layers are object libraries: they compose into rigExec
# and never appear on a test's own link line, so they label nothing today.
# They are listed so a consumer that names one directly is still labeled.
set(_rigexec_project_libs
    rigExec rigExecOpCore rigExecCompile rigExecEval rigExecSchedule
    rigExecVerify rigExecScene rigExecOracle rigExecRuntime rigExecMath rigExecGraph
    rigExecEvalCore rigExecBinary rigExecBake rigExecImaging rigExecAuthoring
    rigExecSampler rigExecLzma rigExecPlayback)
set(_rigexec_fast_direct rigExecMath)

function(_rigexec_normalize_link raw out)
    set(name "${raw}")
    if(name MATCHES "^\\$<")
        if(name MATCHES "^\\$<LINK_ONLY:(.+)>$")
            set(name "${CMAKE_MATCH_1}")
        else()
            set(${out} "" PARENT_SCOPE)
            return()
        endif()
    endif()
    if(TARGET "${name}")
        get_target_property(_alias "${name}" ALIASED_TARGET)
        if(_alias)
            set(name "${_alias}")
        endif()
    endif()
    set(${out} "${name}" PARENT_SCOPE)
endfunction()

function(_rigexec_walk_links target out_direct out_closure)
    set(_direct "")
    set(_seen "")
    set(_stack "${target}")
    set(_first TRUE)
    while(_stack)
        list(POP_FRONT _stack _cur)
        if(NOT TARGET "${_cur}")
            continue()
        endif()
        if(_cur IN_LIST _seen)
            continue()
        endif()
        list(APPEND _seen "${_cur}")
        set(_libs "")
        foreach(_prop LINK_LIBRARIES INTERFACE_LINK_LIBRARIES)
            get_target_property(_got "${_cur}" ${_prop})
            if(_got)
                list(APPEND _libs ${_got})
            endif()
        endforeach()
        foreach(_raw IN LISTS _libs)
            _rigexec_normalize_link("${_raw}" _name)
            if(NOT _name)
                continue()
            endif()
            if(_first)
                list(APPEND _direct "${_name}")
            endif()
            if(TARGET "${_name}" AND NOT _name IN_LIST _seen)
                list(APPEND _stack "${_name}")
            endif()
        endforeach()
        set(_first FALSE)
    endwhile()
    set(${out_direct} "${_direct}" PARENT_SCOPE)
    set(${out_closure} "${_seen}" PARENT_SCOPE)
endfunction()

function(rigexec_label_tests)
    get_property(_tests DIRECTORY PROPERTY TESTS)
    foreach(_test IN LISTS _tests)
        if(_test MATCHES "(Serial|FineClusters|FineClustersReference|DigestGate|ScopedClears|Python)$"
           OR _test MATCHES "Graph_(serial|parallel)$"
           OR _test MATCHES "_(serial|parallel)$")
            set_property(TEST ${_test} APPEND PROPERTY LABELS variant)
        endif()
        get_property(_exe GLOBAL PROPERTY "RIGEXEC_TEST_EXE:${_test}")
        if(NOT _exe OR NOT TARGET "${_exe}")
            continue()
        endif()
        set(_target "${_exe}")
        get_target_property(_alias "${_target}" ALIASED_TARGET)
        if(_alias)
            set(_target "${_alias}")
        endif()
        _rigexec_walk_links("${_target}" _direct _closure)
        set(_labels "")
        set(_pxr FALSE)
        foreach(_lib IN LISTS _closure)
            if(_lib IN_LIST _rigexec_pxr_libs)
                set(_pxr TRUE)
            endif()
        endforeach()
        set(_project_direct "")
        foreach(_lib IN LISTS _direct)
            if(_lib IN_LIST _rigexec_project_libs AND NOT _lib IN_LIST _labels)
                list(APPEND _labels "${_lib}")
            endif()
            if(_lib IN_LIST _rigexec_project_libs)
                list(APPEND _project_direct "${_lib}")
            endif()
        endforeach()
        set(_fixtures "")
        get_property(_fixtures TEST ${_test} PROPERTY FIXTURES_REQUIRED)
        if(NOT _pxr AND NOT _fixtures)
            list(APPEND _labels "usd-free" "fast")
        endif()
        set(_only_math TRUE)
        if(NOT _project_direct)
            set(_only_math FALSE)
        endif()
        foreach(_lib IN LISTS _project_direct)
            if(NOT _lib IN_LIST _rigexec_fast_direct)
                set(_only_math FALSE)
            endif()
        endforeach()
        if(_only_math AND NOT _fixtures AND NOT "fast" IN_LIST _labels)
            list(APPEND _labels "fast")
        endif()
        if(_labels)
            set_property(TEST ${_test} APPEND PROPERTY LABELS ${_labels})
        endif()
    endforeach()
endfunction()
