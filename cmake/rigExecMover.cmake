include_guard(GLOBAL)
include(CMakeParseArguments)

# One module declaration supplies the USD-free definition, the USD adapter,
# and the authoritative schema. Generated factories retain static objects.
function(rigexec_add_mover name)
    cmake_parse_arguments(M "BUILTIN;NO_INSTALL"
        "DEFINITION;TYPE;USD_ADAPTER;FACTORY;SCHEMA;SCHEMA_TYPE;PLUGIN_ROOT"
        "KERNEL;KERNEL_LIBRARIES;LIBRARIES;SCHEMA_DEPENDS" ${ARGN})
    if(M_UNPARSED_ARGUMENTS OR M_KEYWORDS_MISSING_VALUES)
        message(FATAL_ERROR "Invalid rigexec_add_mover(${name}) arguments")
    endif()
    foreach(_required DEFINITION TYPE USD_ADAPTER FACTORY SCHEMA SCHEMA_TYPE)
        if(NOT M_${_required})
            message(FATAL_ERROR "rigexec_add_mover(${name}) requires ${_required}")
        endif()
    endforeach()
    if(NOT name MATCHES "^[A-Za-z_][A-Za-z0-9_]*$")
        message(FATAL_ERROR "Mover module names must be C++ identifiers")
    endif()
    get_property(_schema_types GLOBAL PROPERTY RIGEXEC_MODULE_SCHEMA_TYPES)
    if(M_SCHEMA_TYPE IN_LIST _schema_types)
        message(FATAL_ERROR "Mover schema already registered: ${M_SCHEMA_TYPE}")
    endif()
    set_property(GLOBAL APPEND PROPERTY RIGEXEC_MODULE_SCHEMA_TYPES "${M_SCHEMA_TYPE}")
    foreach(_directory LIBDIR INCLUDEDIR PLUGINDIR)
        if(NOT DEFINED RIGEXEC_INSTALL_${_directory})
            if(_directory STREQUAL "INCLUDEDIR")
                set(RIGEXEC_INSTALL_${_directory} "include")
            elseif(_directory STREQUAL "PLUGINDIR")
                set(RIGEXEC_INSTALL_${_directory} "lib/usd")
            else()
                set(RIGEXEC_INSTALL_${_directory} "lib")
            endif()
        endif()
    endforeach()
    find_package(Python3 REQUIRED COMPONENTS Interpreter)
    if(DEFINED USD_INSTALL_DIR)
        set(_usd "${USD_INSTALL_DIR}")
    else()
        set(_usd "${rigExec_USD_INSTALL_DIR}")
    endif()
    get_filename_component(_schema "${M_SCHEMA}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
    get_filename_component(_definition "${M_DEFINITION}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
    set(_generated "${CMAKE_CURRENT_BINARY_DIR}/${name}-generated")
    file(MAKE_DIRECTORY "${_generated}")
    set(_schema_header "${_generated}/${name}Schema.h")
    set(_registration_header "${_generated}/${name}Registration.h")
    set(_kernel "${_generated}/${name}Kernel.cpp")
    set(_adapter "${_generated}/${name}Registration.cpp")
    file(CONFIGURE OUTPUT "${_registration_header}" CONTENT
        "// Generated mover factory; no USD dependency.\n#pragma once\n#include \"rigExecBinary/moverDefinition.h\"\nnamespace rigExec { RigExecMoverDefinition RigExecDefine${name}(); }\n")
    file(CONFIGURE OUTPUT "${_kernel}" CONTENT
        "// Generated typed mover registration.\n#include \"${_definition}\"\n#include \"${name}Schema.h\"\n#include \"${name}Registration.h\"\nnamespace rigExec {\nRigExecMoverDefinition RigExecDefine${name}() { return {${name}Schema::Type, RigExecMakeMoverKernel<${M_TYPE}>()}; }\n}\n")
    file(CONFIGURE OUTPUT "${_adapter}" CONTENT
        "// Generated USD adapter registration.\n#include \"rigExec/movers/moverRegistry.h\"\n#include \"${name}Registration.h\"\nnamespace rigExec {\nRigExecMoverHandler ${M_FACTORY}(const char *schemaType);\nnamespace {\nbool Register() {\n    const auto definition = RigExecDefine${name}();\n    auto handler = ${M_FACTORY}(definition.schemaType);\n    handler.runtimeKernel = definition.kernel;\n    return RigExecRegisterMoverHandler(std::move(handler));\n}\nconst bool registered = Register();\n}\n}\n")
    set(_schema_outputs "${_schema_header}")
    set(_schema_args)
    if(M_BUILTIN)
        if(NOT TARGET rigExec OR NOT TARGET rigExecRuntime)
            message(FATAL_ERROR "BUILTIN movers require the RigExec build targets")
        endif()
        target_sources(rigExec PRIVATE "${M_USD_ADAPTER}" "${_adapter}" "${_kernel}" ${M_KERNEL})
        target_sources(rigExecRuntime PRIVATE "${_kernel}" ${M_KERNEL})
        if(M_KERNEL_LIBRARIES)
            target_link_libraries(rigExec PRIVATE ${M_KERNEL_LIBRARIES})
            target_link_libraries(rigExecRuntime PRIVATE ${M_KERNEL_LIBRARIES})
        endif()
        target_include_directories(rigExec PRIVATE "${_generated}")
        target_include_directories(rigExecRuntime PRIVATE "${_generated}")
        # The catalog is generated from declarations, not from a maintained
        # engine switch. Each call contributes one direct factory reference.
        set_property(GLOBAL APPEND PROPERTY RIGEXEC_BUILTIN_MOVERS "${name}")
        get_property(_builtins GLOBAL PROPERTY RIGEXEC_BUILTIN_MOVERS)
        list(LENGTH _builtins _count)
        set(_catalog "#include \"rigExecRuntime/moverCatalog.h\"\n#include <array>\n")
        foreach(_mover IN LISTS _builtins)
            string(APPEND _catalog "#include \"${_mover}Registration.h\"\n")
        endforeach()
        string(APPEND _catalog "namespace rigExec { namespace {\nconstexpr std::array<RigExecMoverFactory, ${_count}> movers = {{\n")
        foreach(_mover IN LISTS _builtins)
            string(APPEND _catalog "    &RigExecDefine${_mover},\n")
        endforeach()
        string(APPEND _catalog "}};\n}\nconst RigExecMoverFactory *RrBuiltinMovers(size_t *count) { *count = movers.size(); return movers.data(); }\n}\n")
        set(_catalog_path "${CMAKE_BINARY_DIR}/generated/moverCatalog.cpp")
        file(CONFIGURE OUTPUT "${_catalog_path}" CONTENT "${_catalog}")
        if(_count EQUAL 1)
            target_sources(rigExecRuntime PRIVATE "${_catalog_path}")
        endif()
    else()
        add_library(${name}Kernel STATIC "${_kernel}" ${M_KERNEL})
        target_compile_features(${name}Kernel PUBLIC cxx_std_17)
        target_include_directories(${name}Kernel PUBLIC
            $<BUILD_INTERFACE:${_generated}>
            $<INSTALL_INTERFACE:${RIGEXEC_INSTALL_INCLUDEDIR}/rigExecMovers/${name}>)
        target_link_libraries(${name}Kernel PUBLIC rigExec::rigExecBinary ${M_KERNEL_LIBRARIES})
        set_target_properties(${name}Kernel PROPERTIES POSITION_INDEPENDENT_CODE ON)
        if(MSVC)
            target_compile_options(${name}Kernel PRIVATE /fp:precise)
        else()
            target_compile_options(${name}Kernel PRIVATE -fno-fast-math -ffp-contract=off)
        endif()
        set(_plugin_options SCHEMA_INCLUDE)
        if(M_NO_INSTALL)
            list(APPEND _plugin_options NO_INSTALL)
        endif()
        if(M_PLUGIN_ROOT)
            list(APPEND _plugin_options PLUGIN_ROOT "${M_PLUGIN_ROOT}")
        endif()
        rigexec_add_mover_plugin(${name} ${_plugin_options}
            SOURCES "${M_USD_ADAPTER}" "${_adapter}"
            LIBRARIES ${name}Kernel ${M_LIBRARIES})
        get_target_property(_resources ${name} RIGEXEC_PLUGIN_RESOURCE_DIR)
        list(APPEND _schema_args --resources "${_resources}/schema")
        list(APPEND _schema_outputs "${_resources}/schema/generatedSchema.usda" "${_resources}/schema/plugInfo.json")
        if(NOT M_NO_INSTALL)
            install(TARGETS ${name}Kernel EXPORT ${name}Targets ARCHIVE DESTINATION "${RIGEXEC_INSTALL_LIBDIR}")
            install(EXPORT ${name}Targets NAMESPACE rigExecMovers:: DESTINATION "${RIGEXEC_INSTALL_LIBDIR}/cmake/${name}")
            file(CONFIGURE OUTPUT "${_generated}/${name}Config.cmake" CONTENT
                "include(CMakeFindDependencyMacro)\nfind_dependency(rigExec CONFIG)\ninclude(\"\${CMAKE_CURRENT_LIST_DIR}/${name}Targets.cmake\")\n" @ONLY)
            install(FILES "${_generated}/${name}Config.cmake" DESTINATION "${RIGEXEC_INSTALL_LIBDIR}/cmake/${name}")
            install(FILES "${_registration_header}" "${_schema_header}" DESTINATION "${RIGEXEC_INSTALL_INCLUDEDIR}/rigExecMovers/${name}")
            install(FILES "${_resources}/schema/generatedSchema.usda" "${_resources}/schema/plugInfo.json"
                DESTINATION "${RIGEXEC_INSTALL_PLUGINDIR}/rigExecMoverPlugins/${name}/resources/schema")
        endif()
    endif()
    add_custom_command(OUTPUT ${_schema_outputs}
        COMMAND "${Python3_EXECUTABLE}" -S "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/generateMoverSchema.py"
            --usd "${_usd}" --schema "${_schema}" --type "${M_SCHEMA_TYPE}"
            --namespace "${name}Schema" --header "${_schema_header}" ${_schema_args}
        DEPENDS "${_schema}" ${M_SCHEMA_DEPENDS} "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/generateMoverSchema.py"
        VERBATIM)
    add_custom_target(${name}Schema DEPENDS ${_schema_outputs})
    if(M_BUILTIN)
        add_dependencies(rigExec ${name}Schema)
        add_dependencies(rigExecRuntime ${name}Schema)
    else()
        add_dependencies(${name}Kernel ${name}Schema)
        add_dependencies(${name} ${name}Schema)
    endif()
endfunction()
