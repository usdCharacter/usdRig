        {
            over "CurtainCloth"
            {
                rel rigExec:restShape = </ClothAsset/Geom/Curtain.points>
                rel rigExec:uvSet = </ClothAsset/Geom/Curtain.primvars:st>
                rel rigExec:constraints = [
                    </ClothAsset/Rig/Movers/CurtainCloth/Stretch>,
                    </ClothAsset/Rig/Movers/CurtainCloth/Bend>,
                    </ClothAsset/Rig/Movers/CurtainCloth/Damping>,
                    </ClothAsset/Rig/Movers/CurtainCloth/Hem>,
                    </ClothAsset/Rig/Movers/CurtainCloth/Contact>
                ]
                def RigExecClothMap "Paint"
                {
                    rel rigExec:values = </ClothAsset/Geom/Curtain.primvars:stretch>
                }
                def RigExecClothConstraintSet "Stretch"
                {
                    uniform token rigExec:kind = "stretch"
                    uniform float inputs:compliance = 0.00001
                    uniform float inputs:minStrength = 0.2
                    uniform float inputs:maxStrength = 1
                    uniform float inputs:warp = 4
                    uniform float inputs:weft = 1
                    uniform float2[] rigExec:forceCurve = [(0, 1), (10000, 0)]
                    rel rigExec:maskMap = </ClothAsset/Rig/Movers/CurtainCloth/Paint>
                }
                def RigExecClothConstraintSet "Bend"
                {
                    uniform token rigExec:kind = "bend"
                    uniform float inputs:compliance = 0.001
                    uniform float inputs:warp = 2
                    uniform float inputs:weft = 1
                }
                def RigExecClothConstraintSet "Damping"
                {
                    uniform token rigExec:kind = "damping"
                    uniform float inputs:minStrength = 8
                    uniform float inputs:maxStrength = 8
                    uniform float inputs:warp = 1
                    uniform float inputs:weft = 1.5
                }
                def RigExecClothBinding "LeftHem"
                {
                    uniform int[] rigExec:indices = [272]
                }
                def RigExecClothBinding "RightHem"
                {
                    uniform int[] rigExec:indices = [288]
                }
                def RigExecClothConstraintSet "Hem"
                {
                    uniform token rigExec:kind = "attachment"
                    uniform float inputs:restLength = 24
                    uniform float inputs:compliance = 0.001
                    rel rigExec:sourceBinding = </ClothAsset/Rig/Movers/CurtainCloth/LeftHem>
                    rel rigExec:targetBinding = </ClothAsset/Rig/Movers/CurtainCloth/RightHem>
                }
                def RigExecClothConstraintSet "Contact"
                {
                    uniform token rigExec:kind = "selfCollision"
                    uniform token rigExec:mode = "hard"
                    uniform float inputs:thickness = 0.15
                    uniform float inputs:friction = 0.3
                }
            }
        }
    }
}

