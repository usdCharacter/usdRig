                rel rigExec:transform = </ClothAsset/Rig/Controls/Bar> (
                    rigExecReadPhase = "final"
                )
                rel rigExec:weightObject = </ClothAsset/Rig/Weights/CurtainW>
            }
            def RigExecMatrixMover "BarFollow" (
                prepend apiSchemas = ["RigExecMoverAPI"]
            )
