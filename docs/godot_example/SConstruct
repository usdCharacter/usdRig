#!/usr/bin/env python
"""Builds the rigExec GDExtension against godot-cpp.

The zero-USD runtime (rigExecRuntime, the rigExecEvalCore step table, the
portable operation graph compiler and executor, and the rigExecBinary
format reader) compiles from the sibling usdRig checkout straight into the
extension -- never a shared DLL. The FlatBuffers headers come from usdRig's
thirdparty/flatbuffers/include. Objects go under build/obj/<suffix>, never
into either source tree.
Floating point stays precise, and this file never spells the settings out:
it reads the exact-FP flags from the SDK's installed
lib/cmake/rigExec/rigexec_flags.cmake fragment (rigexec_get_exact_fp_flags),
the same authority the CMake build and bin/check_runtime_usd_free.sh follow.
The USD-free source and include lists come from the manifests the SDK
installs under share/rigExec/ -- runtimeSources.txt, evalCoreSources.txt,
runtimeIncludes.txt and evalCoreIncludes.txt -- or, when no SDK is
installed, from the same four files in a configured usdRig build tree.
Both grammars reserve the first path component "runtime-generated": an
entry starting with it names a translation unit this SDK ships beside the
manifests and resolves under the manifest directory M, every other entry
resolves under the usdRig checkout C. Only a configured build tree may name
an absolute path, and only inside its own checkout or binary root. Object
targets are build/obj/<suffix>/generated/<path under M/runtime-generated>
for generated units and build/obj/<suffix>/checkout/<path under C> for
checkout units, so debug and release never share an object target.

Usage:
    scons platform=<windows|linux|macos> target=<template_debug|template_release>
    scons platform=windows target=template_release api_version=4.7
    scons platform=windows usdrig_root=<usdRig checkout>
    scons platform=windows sdk_root=<usdRig install prefix, default ../usd-install>
"""

import os
import re

from SCons.Script import ARGUMENTS, Default, SConscript

godot_cpp = os.path.join("thirdparty", "godot-cpp")

MANIFEST_NAMES = ("runtimeSources.txt", "evalCoreSources.txt",
                  "runtimeIncludes.txt", "evalCoreIncludes.txt")
# The reserved first component of an installed manifest entry: the generated
# mover payload shipped with the SDK (cmake/rigExecConfig.cmake.in).
GENERATED_COMPONENT = "runtime-generated"


def _godot_cpp_env():
    scons_script = os.path.join(godot_cpp, "SConstruct")
    if not os.path.isfile(scons_script):
        print("godot-cpp not found at thirdparty/godot-cpp")
        print("pin: master @ 507ed9d840c01a3c5b2a39af8bb4000bfac30bf5")
        raise SystemExit(1)
    return SConscript(scons_script)


env = _godot_cpp_env()

# The runtime compiles from the sibling usdRig checkout; the flag fragment
# and the manifests come from the SDK installed from it.
usdrig_root = os.path.abspath(ARGUMENTS.get("usdrig_root", os.path.join("..", "usdRig")))
usdrig_libs = os.path.join(usdrig_root, "libs")
build_root = os.path.join(usdrig_root, "build")
sdk_root = os.path.abspath(ARGUMENTS.get("sdk_root", os.path.join("..", "usd-install")))


def _read_lines(path):
    with open(path, "r", encoding="utf-8") as handle:
        return [line.strip() for line in handle if line.strip()]


def _exact_fp_flags(fragment, msvc):
    """The flags rigexec_get_exact_fp_flags sets for this compiler."""
    with open(fragment, "r", encoding="utf-8") as handle:
        text = handle.read()
    body = re.search(
        r"function\s*\(\s*rigexec_get_exact_fp_flags\b.*?\)(.*?)endfunction\s*\(\s*\)",
        text, re.S)
    branch = None
    if body:
        if msvc:
            branch = re.search(r"if\s*\(\s*MSVC\s*\)(.*?)else", body.group(1), re.S)
        else:
            branch = re.search(r"else\s*\(\s*\)(.*?)endif", body.group(1), re.S)
    flags = []
    if branch:
        assignment = re.search(r"set\(\s*\$\{\w+\}\s+(.*?)\s+PARENT_SCOPE\s*\)",
                               branch.group(1), re.S)
        if assignment:
            flags = assignment.group(1).split()
    if not flags:
        print(fragment + " names no exact-FP flags for "
              + ("MSVC" if msvc else "non-MSVC") + " builds")
        raise SystemExit(1)
    return flags


def _first_existing(candidates, what):
    for candidate in candidates:
        if os.path.isfile(candidate):
            return candidate
    print("no " + what + " at: " + ", ".join(candidates))
    raise SystemExit(1)


flags_fragment = _first_existing(
    (os.path.join(sdk_root, "lib", "cmake", "rigExec", "rigexec_flags.cmake"),
     os.path.join(usdrig_root, "cmake", "rigexec_flags.cmake")),
    "the cmake/rigexec_flags.cmake exact-FP fragment")


def _manifest_source():
    """(manifest directory, its grammar): the SDK's share/rigExec, or a
    configured usdRig build tree. The two are not interchangeable, so the
    mode is decided once and every entry is read under it."""
    for directory, mode in ((os.path.join(sdk_root, "share", "rigExec"), "sdk"),
                            (build_root, "build")):
        if all(os.path.isfile(os.path.join(directory, name))
               for name in MANIFEST_NAMES):
            return directory, mode
    print("no manifest set (" + ", ".join(MANIFEST_NAMES) + ") under "
          + os.path.join(sdk_root, "share", "rigExec") + " or "
          + build_root + "; install the usdRig SDK or configure its build")
    raise SystemExit(1)


manifest_dir, manifest_mode = _manifest_source()
# The generated payload root is M/runtime-generated in both grammars.
generated_root = os.path.join(manifest_dir, GENERATED_COMPONENT)


def _under(root, path):
    return path == root or path.startswith(root + os.sep)


def _entry_failure(manifest, entry, attempted, reason):
    print(manifest + " entry " + entry + " " + reason + " (attempted "
          + attempted + ")")
    if manifest_mode == "sdk":
        print("the installed SDK does not match this checkout: install an SDK "
            "built from the same usdRig, whose mover generation writes the "
            "runtime-generated payload")
    raise SystemExit(1)


def _resolve(manifest, entry):
    """One manifest entry -> an existing absolute path, per its grammar."""
    spelling = entry.replace("\\", "/")
    segments = spelling.split("/")
    if spelling.startswith("/") or segments[0].endswith(":"):
        if manifest_mode != "build":
            _entry_failure(manifest, entry, spelling,
                           "is absolute, which an installed manifest never is")
        attempted = os.path.normpath(spelling)
        if not (_under(build_root, attempted) or _under(usdrig_root, attempted)):
            _entry_failure(manifest, entry, attempted,
                           "is outside this build tree and this checkout")
        return attempted
    if ".." in segments:
        _entry_failure(manifest, entry, spelling, "carries a '..' segment")
    if segments[0] == GENERATED_COMPONENT:
        attempted = os.path.normpath(os.path.join(manifest_dir, spelling))
        if not _under(generated_root, attempted):
            _entry_failure(manifest, entry, attempted,
                           "left the generated payload root")
        return attempted
    attempted = os.path.normpath(os.path.join(usdrig_root, spelling))
    if not _under(usdrig_root, attempted):
        _entry_failure(manifest, entry, attempted,
                       "is outside the usdRig checkout")
    return attempted


def _manifest_paths(manifest_name, want_file):
    manifest = os.path.join(manifest_dir, manifest_name)
    paths = []
    for entry in _read_lines(manifest):
        path = _resolve(manifest, entry)
        if not (os.path.isfile(path) if want_file else os.path.isdir(path)):
            _entry_failure(manifest, entry, path,
                          "is not a " + ("file" if want_file else "directory"))
        paths.append((path, _under(generated_root, path)))
    return paths


# Bitwise parity with the baked path, from the build's flag authority.
is_msvc = env.get("is_msvc", False)
env.Append(CXXFLAGS=_exact_fp_flags(flags_fragment, is_msvc)
           + ["/std:c++17" if is_msvc else "-std=c++17"])

flatbuffers_include = os.path.join(usdrig_root, "thirdparty", "flatbuffers",
                                   "include")
if not os.path.isfile(os.path.join(flatbuffers_include, "flatbuffers",
                                   "flatbuffers.h")):
    print(usdrig_root + " has no thirdparty/flatbuffers; check out a usdRig "
          "with the FlatBuffer .rigexec format")
    raise SystemExit(1)

# The USD-free translation units and include directories, exactly as the
# manifests list them -- the same lists bin/check_runtime_usd_free.sh
# compiles. The extension needs them all: the runtime links EvalCore.
runtime_sources = [(path, generated)
                   for path, generated in
                   _manifest_paths("runtimeSources.txt", True)
                   if path.endswith((".cpp", ".c"))]
runtime_sources += [(path, generated)
                    for path, generated in
                    _manifest_paths("evalCoreSources.txt", True)
                    if path.endswith((".cpp", ".c"))]
if not runtime_sources:
    print("the manifests under " + manifest_dir + " name no source files")
    raise SystemExit(1)
include_dirs = []
for name in ("runtimeIncludes.txt", "evalCoreIncludes.txt"):
    include_dirs.extend(path for path, _ in _manifest_paths(name, False))

# The extension's own wiring: the format reader and the portable operation
# graph. Other rigExecGraph sources require USD and do not enter this
# extension. These are the same additions bin/check_runtime_usd_free.sh
# compiles on top of the two source manifests.
format_source = os.path.join(usdrig_libs, "rigExecBinary", "format.cpp")
transport_source = os.path.join(usdrig_libs, "rigExecBinary", "transport.cpp")
graph_source = os.path.join(usdrig_libs, "rigExecGraph", "opGraph.cpp")
lzma_dir = os.path.join(usdrig_root, "thirdparty", "lzma", "C")
lzma_sources = [os.path.join(lzma_dir, name) for name in
                ("LzmaEnc.c", "LzmaDec.c", "LzFind.c", "CpuArch.c")]
if not all(os.path.isfile(source)
           for source in (format_source, transport_source, graph_source,
                          *lzma_sources)):
    print("missing the format reader, portable operation graph, or LZMA "
          "sources under " + usdrig_root)
    raise SystemExit(1)
runtime_sources.extend((source, False) for source in
                       (format_source, transport_source, graph_source))
env.Append(CPPPATH=[usdrig_libs, flatbuffers_include, lzma_dir] + include_dirs)
addon_dir = os.path.join("addons", "rigexec", "src")
addon_sources = sorted(os.path.join(addon_dir, name)
                       for name in os.listdir(addon_dir)
                       if name.endswith(".cpp"))

# godot-cpp compiles with exceptions off; the rigExec runtime and EvalCore
# units use exception handling exactly as the CMake build does, so those
# units alone get it back. The floating-point authority is untouched.
runtime_env = env.Clone()
if is_msvc:
    runtime_env.Append(CPPDEFINES=["_HAS_EXCEPTIONS=1"], CXXFLAGS=["/EHsc"])
else:
    runtime_env.Append(CXXFLAGS=["-fexceptions"])

# One object dir per build suffix, so debug and release coexist and
# platforms whose object suffix omits it (.os) do not collide. Generated
# units key off the payload root and checkout units off the checkout, so
# neither can land on the other's target.
obj_root = os.path.join("build", "obj", env["suffix"].lstrip("."))


def _object_key(source, generated):
    stem = os.path.splitext(
        os.path.relpath(source, generated_root if generated else usdrig_root)
        .replace("\\", "/"))[0]
    if stem.startswith("/") or stem.split("/")[0].endswith(":") or ".." in stem.split("/"):
        print(source + " has no object key relative to the "
              + ("generated" if generated else "checkout") + " root")
        raise SystemExit(1)
    return os.path.join(obj_root, "generated" if generated else "checkout", stem)


objects = [runtime_env.SharedObject(_object_key(source, generated), source)
           for source, generated in runtime_sources]
lzma_env = env.Clone()
lzma_env.Append(CPPDEFINES=["Z7_ST", "RIGEXEC_LZMA_PORTABLE_SCALAR"])
objects += [lzma_env.SharedObject(_object_key(s, False), s)
           for s in lzma_sources]
objects += [
    env.SharedObject(
        os.path.join(obj_root, "addon",
                     os.path.splitext(os.path.basename(s))[0]), s)
    for s in addon_sources
]

if env["platform"] == "macos":
    library_path = os.path.join(
        "addons", "rigexec", "bin",
        "librigexec{}.framework".format(env["suffix"]),
        "librigexec{}".format(env["suffix"]),
    )
else:
    library_path = os.path.join(
        "addons", "rigexec", "bin",
        "librigexec{}{}".format(env["suffix"], env["SHLIBSUFFIX"]),
    )
library = env.SharedLibrary(library_path, source=objects)
Default(library)
