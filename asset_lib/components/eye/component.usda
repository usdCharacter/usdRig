#usda 1.0
(
    defaultPrim = "Component"
    doc = "Reusable eye rig definitions. Bind with component.json and character fit data."
)

def Scope "Component"
{
    def RigExecControl "Control_LookAt" (
        apiSchemas = ["RigExecControlAPI"]
        doc = "This eye's own look target, riding LookAt."
    )
    {
        double avars:tx = 0
        double avars:ty = 0
        double avars:tz = 0
        uniform token guide:planeNormal = "Z"
        uniform token guide:shape = "circle"
    }

    def RigExecControl "Control_EyeAim" (
        apiSchemas = ["RigExecControlAPI"]
        doc = "Aimed at LookAt by a constraint; the eye control sits on it."
    )
    {
        uniform token guide:planeNormal = "Y"
        uniform token guide:shape = "circle"
    }

    def RigExecControl "Control_Eye" (
        apiSchemas = ["RigExecControlAPI"]
        doc = "Turns the eye about its centre on top of the aim (rx up/down, ry side to side); its other avars are the eye shader's dials, zero = as authored."
    )
    {
        custom double avars:irisHeight = 0
        custom double avars:irisRadius = 0
        custom double avars:irisWidth = 0
        custom double avars:pupilHeight = 0
        custom double avars:pupilOffsetX = 0
        custom double avars:pupilOffsetY = 0
        custom double avars:pupilRadius = 0
        custom double avars:pupilWidth = 0
        double avars:rx = 0
        double avars:ry = 0
        double avars:rz = 0
        uniform token guide:planeNormal = "Z"
        uniform token guide:shape = "circle"
    }

    def RigExecControl "Control_LidUpper" (
        apiSchemas = ["RigExecControlAPI"]
        doc = "The upper lid: +rx closes it. Its blink dial closes this eye (0 to 1)."
    )
    {
        custom float avars:blink = 0
        double avars:rx = 0
        uniform token guide:shape = "custom"
    }

    def RigExecControl "Control_LidLower" (
        apiSchemas = ["RigExecControlAPI"]
        doc = "The lower lid: +rx closes it."
    )
    {
        double avars:rx = 0
        uniform token guide:shape = "custom"
    }

    def RigExecSurfaceProjector "Projector_EyeProjector" (
        apiSchemas = ["RigExecMoverAPI"]
    )
    {
        double3 rigExec:rayUp = (0, 1, 0)
        uniform token rigExec:shaderDialPrimvar = "eyeDials"
        uniform token rigExec:shaderPrimvar = "eyeProjector"
    }

    def RigExecMatrixMover "Geometry_Eye_Turn" (
        apiSchemas = ["RigExecMoverAPI"]
    )
    {
        uniform token rigExec:weightBlend = "radial"
    }

    def RigExecMatrixMover "Geometry_LidUpper_Head" (
        apiSchemas = ["RigExecMoverAPI"]
    )
    {
        uniform token rigExec:weightBlend = "radial"
    }

    def RigExecMatrixMover "Geometry_LidUpper_Lid" (
        apiSchemas = ["RigExecMoverAPI"]
    )
    {
        uniform token rigExec:weightBlend = "radial"
    }

    def RigExecBlendShapeMover "Geometry_LidUpper_Blink" (
        apiSchemas = ["RigExecMoverAPI"]
    )
    {
    }

    def RigExecMatrixMover "Geometry_LidLower_Head" (
        apiSchemas = ["RigExecMoverAPI"]
    )
    {
        uniform token rigExec:weightBlend = "radial"
    }

    def RigExecMatrixMover "Geometry_LidLower_Lid" (
        apiSchemas = ["RigExecMoverAPI"]
    )
    {
        uniform token rigExec:weightBlend = "radial"
    }

    def RigExecBlendShapeMover "Geometry_LidLower_Blink" (
        apiSchemas = ["RigExecMoverAPI"]
    )
    {
    }

    def RigExecAimConstraint "Constraint_EyeAim" (
        apiSchemas = ["RigExecMoverAPI"]
    )
    {
        double3 inputs:aimVector = (0, 0, 1)
        double3 inputs:upVector = (0, 1, 0)
        double3 inputs:worldUpVector = (0, 1, 0)
        uniform token rigExec:worldUpType = "objectRotationUp"
    }

    def RigExecFloatMathMover "Channel_BlinkUpper_Clamp" (
        apiSchemas = ["RigExecMoverAPI"]
    )
    {
        float inputs:max = 1
        float inputs:min = 0
        uniform token rigExec:operation = "clamp"
    }

    def RigExecFloatMathMover "Channel_BlinkUpper_AddBoth" (
        apiSchemas = ["RigExecMoverAPI"]
    )
    {
        float inputs:value
        uniform token rigExec:operation = "add"
    }

    def RigExecFloatMathMover "Channel_BlinkUpper_AddEye" (
        apiSchemas = ["RigExecMoverAPI"]
    )
    {
        float inputs:value
        uniform token rigExec:operation = "add"
    }

    def RigExecFloatMathMover "Channel_BlinkLower_Clamp" (
        apiSchemas = ["RigExecMoverAPI"]
    )
    {
        float inputs:max = 1
        float inputs:min = 0
        uniform token rigExec:operation = "clamp"
    }

    def RigExecFloatMathMover "Channel_BlinkLower_AddBoth" (
        apiSchemas = ["RigExecMoverAPI"]
    )
    {
        float inputs:value
        uniform token rigExec:operation = "add"
    }

    def RigExecFloatMathMover "Channel_BlinkLower_AddEye" (
        apiSchemas = ["RigExecMoverAPI"]
    )
    {
        float inputs:value
        uniform token rigExec:operation = "add"
    }

    def RigExecBlendInput "Input_BlinkUpper"
    {
        float inputs:weight = 0
    }

    def RigExecBlendSample "Sample_BlinkUpper_S1"
    {
        float rigExec:activation = 0.33333334
    }

    def RigExecBlendSample "Sample_BlinkUpper_S2"
    {
        float rigExec:activation = 0.6666667
    }

    def RigExecBlendSample "Sample_BlinkUpper_S3"
    {
        float rigExec:activation = 1
    }

    def RigExecBlendInput "Input_BlinkLower"
    {
        float inputs:weight = 0
    }

    def RigExecBlendSample "Sample_BlinkLower_S1"
    {
        float rigExec:activation = 0.33333334
    }

    def RigExecBlendSample "Sample_BlinkLower_S2"
    {
        float rigExec:activation = 0.6666667
    }

    def RigExecBlendSample "Sample_BlinkLower_S3"
    {
        float rigExec:activation = 1
    }

    def BlendShape "Shape_BlinkUpper_1"
    {
    }

    def BlendShape "Shape_BlinkUpper_2"
    {
    }

    def BlendShape "Shape_BlinkUpper_3"
    {
    }

    def BlendShape "Shape_BlinkLower_1"
    {
    }

    def BlendShape "Shape_BlinkLower_2"
    {
    }

    def BlendShape "Shape_BlinkLower_3"
    {
    }
}

