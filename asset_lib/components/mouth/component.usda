#usda 1.0
(
    defaultPrim = "Component"
    doc = "Reusable mouth rig definitions. Bind with component.json and character fit data."
)

def Scope "Component"
{
    def RigExecControl "Control_Jaw" (
        apiSchemas = ["RigExecControlAPI"]
        doc = "The jaw, turning about its hinge below the ears: +rx opens the mouth."
    )
    {
        double avars:rx = 0
        double avars:ry = 0
        double avars:rz = 0
        double avars:tx = 0
        double avars:ty = 0
        double avars:tz = 0
        uniform token guide:planeNormal = "Z"
        uniform token guide:shape = "circle"
    }

    def RigExecControl "Control_LowerLip" (
        apiSchemas = ["RigExecControlAPI"]
        doc = "The lower lip, on the jaw: ty raises it, rx curls it."
    )
    {
        double avars:rx = 0
        double avars:ry = 0
        double avars:rz = 0
        double avars:tx = 0
        double avars:ty = 0
        double avars:tz = 0
        uniform token guide:planeNormal = "Z"
        uniform token guide:shape = "box"
    }

    def RigExecControl "Control_UpperLip" (
        apiSchemas = ["RigExecControlAPI"]
        doc = "The upper lip: ty raises it (a sneer), rx curls it."
    )
    {
        double avars:rx = 0
        double avars:ry = 0
        double avars:rz = 0
        double avars:tx = 0
        double avars:ty = 0
        double avars:tz = 0
        uniform token guide:planeNormal = "Z"
        uniform token guide:shape = "box"
    }

    def RigExecControl "Control_MouthCornerR" (
        apiSchemas = ["RigExecControlAPI"]
        doc = "The mouth's corner: ty smiles or frowns, tx widens."
    )
    {
        double avars:rx = 0
        double avars:ry = 0
        double avars:rz = 0
        double avars:tx = 0
        double avars:ty = 0
        double avars:tz = 0
        uniform token guide:shape = "sphere"
    }

    def RigExecControl "Control_MouthCornerL" (
        apiSchemas = ["RigExecControlAPI"]
        doc = "The mouth's corner: ty smiles or frowns, tx widens."
    )
    {
        double avars:rx = 0
        double avars:ry = 0
        double avars:rz = 0
        double avars:tx = 0
        double avars:ty = 0
        double avars:tz = 0
        uniform token guide:shape = "sphere"
    }

    def RigExecStaticWeight "Weight"
    {
        uniform float rigExec:defaultWeight = 0
        uniform token rigExec:representation = "sparse"
    }

    def RigExecMatrixMover "Deform_Jaw_Weighted" (
        apiSchemas = ["RigExecMoverAPI"]
    )
    {
        uniform token rigExec:weightBlend = "radial"
    }

    def RigExecMatrixMover "Deform_LowerLip_Weighted" (
        apiSchemas = ["RigExecMoverAPI"]
    )
    {
        uniform token rigExec:weightBlend = "radial"
    }

    def RigExecMatrixMover "Deform_UpperLip_Weighted" (
        apiSchemas = ["RigExecMoverAPI"]
    )
    {
        uniform token rigExec:weightBlend = "radial"
    }

    def RigExecMatrixMover "Deform_MouthCornerR_Weighted" (
        apiSchemas = ["RigExecMoverAPI"]
    )
    {
        uniform token rigExec:weightBlend = "radial"
    }

    def RigExecMatrixMover "Deform_MouthCornerL_Weighted" (
        apiSchemas = ["RigExecMoverAPI"]
    )
    {
        uniform token rigExec:weightBlend = "radial"
    }
}

