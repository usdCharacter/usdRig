#usda 1.0
(
    defaultPrim = "Component"
    doc = "Reusable head rig definitions. Bind with component.json and character fit data."
)

def Scope "Component"
{
    def RigExecControl "Control_Neck" (
        apiSchemas = ["RigExecControlAPI"]
    )
    {
        double avars:rx = 0
        double avars:ry = 0
        double avars:rz = 0
        double avars:tx = 0
        double avars:ty = 0
        double avars:tz = 0
        uniform token guide:planeNormal = "Y"
        uniform token guide:shape = "circle"
    }

    def RigExecControl "Control_Head" (
        apiSchemas = ["RigExecControlAPI"]
        doc = "The head (its ring floats above it), carrying the face."
    )
    {
        double avars:rx = 0
        double avars:ry = 0
        double avars:rz = 0
        double avars:tx = 0
        double avars:ty = 0
        double avars:tz = 0
        uniform token guide:planeNormal = "Y"
        uniform token guide:shape = "circle"
    }

    def RigExecControl "Control_CheekR" (
        apiSchemas = ["RigExecControlAPI"]
        doc = "The cheek: ty raises it, tz puffs it."
    )
    {
        double avars:rx = 0
        double avars:ry = 0
        double avars:rz = 0
        double avars:tx = 0
        double avars:ty = 0
        double avars:tz = 0
        uniform token guide:shape = "sphere"
    }

    def RigExecControl "Control_EarR" (
        apiSchemas = ["RigExecControlAPI"]
        doc = "The ear, turning about its root."
    )
    {
        double avars:rx = 0
        double avars:ry = 0
        double avars:rz = 0
        uniform token guide:planeNormal = "X"
        uniform token guide:shape = "circle"
    }

    def RigExecControl "Control_BrowR" (
        apiSchemas = ["RigExecControlAPI"]
        doc = "The brow: ty raises it, rz tilts it."
    )
    {
        double avars:rx = 0
        double avars:ry = 0
        double avars:rz = 0
        double avars:tx = 0
        double avars:ty = 0
        double avars:tz = 0
        uniform token guide:planeNormal = "Z"
        uniform token guide:shape = "box"
    }

    def RigExecControl "Control_BrowInnerR" (
        apiSchemas = ["RigExecControlAPI"]
        doc = "The brow's inner end."
    )
    {
        double avars:rx = 0
        double avars:ry = 0
        double avars:rz = 0
        double avars:tx = 0
        double avars:ty = 0
        double avars:tz = 0
        uniform token guide:shape = "sphere"
    }

    def RigExecControl "Control_BrowOuterR" (
        apiSchemas = ["RigExecControlAPI"]
        doc = "The brow's outer end."
    )
    {
        double avars:rx = 0
        double avars:ry = 0
        double avars:rz = 0
        double avars:tx = 0
        double avars:ty = 0
        double avars:tz = 0
        uniform token guide:shape = "sphere"
    }

    def RigExecControl "Control_CheekL" (
        apiSchemas = ["RigExecControlAPI"]
