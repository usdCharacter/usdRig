    )
    {
        double avars:rx = 0
        double avars:ry = 0
        double avars:rz = 0
        double avars:tx = 0
        double avars:ty = 0
        double avars:tz = 0
        uniform token guide:shape = "sphere"
    }

    def RigExecControl "Control_EarL" (
        apiSchemas = ["RigExecControlAPI"]
        doc = "The ear, turning about its root."
    )
    {
        double avars:rx = 0
        double avars:ry = 0
        double avars:rz = 0
        uniform token guide:planeNormal = "X"
        uniform token guide:shape = "circle"
    }

    def RigExecControl "Control_BrowL" (
        apiSchemas = ["RigExecControlAPI"]
        doc = "The brow: ty raises it, rz tilts it."
    )
    {
        double avars:rx = 0
        double avars:ry = 0
        double avars:rz = 0
        double avars:tx = 0
        double avars:ty = 0
        double avars:tz = 0
        uniform token guide:planeNormal = "Z"
        uniform token guide:shape = "box"
    }

    def RigExecControl "Control_BrowInnerL" (
        apiSchemas = ["RigExecControlAPI"]
        doc = "The brow's inner end."
    )
    {
        double avars:rx = 0
        double avars:ry = 0
        double avars:rz = 0
        double avars:tx = 0
        double avars:ty = 0
        double avars:tz = 0
        uniform token guide:shape = "sphere"
    }

    def RigExecControl "Control_BrowOuterL" (
        apiSchemas = ["RigExecControlAPI"]
        doc = "The brow's outer end."
    )
    {
        double avars:rx = 0
        double avars:ry = 0
        double avars:rz = 0
        double avars:tx = 0
        double avars:ty = 0
        double avars:tz = 0
        uniform token guide:shape = "sphere"
    }

    def RigExecControl "Control_Nose" (
        apiSchemas = ["RigExecControlAPI"]
        doc = "The nose, turning about its root between the eyes."
    )
    {
        double avars:rx = 0
        double avars:ry = 0
        double avars:rz = 0
        double avars:tx = 0
        double avars:ty = 0
        double avars:tz = 0
        uniform token guide:shape = "sphere"
    }

    def RigExecControl "Control_LookAt" (
        apiSchemas = ["RigExecControlAPI"]
        doc = "Where the eyes look (it rides the head). Its blink dial closes both eyes (0 to 1)."
    )
    {
        custom float avars:blink = 0
        double avars:tx = 0
        double avars:ty = 0
        double avars:tz = 0
        uniform token guide:planeNormal = "Z"
        uniform token guide:shape = "box"
    }

    def RigExecStaticWeight "Weight"
    {
        uniform float rigExec:defaultWeight = 0
        uniform token rigExec:representation = "sparse"
    }

    def RigExecMatrixMover "Deform_Neck_Weighted" (
        apiSchemas = ["RigExecMoverAPI"]
    )
    {
        uniform token rigExec:weightBlend = "radial"
    }

    def RigExecMatrixMover "Deform_Head_Weighted" (
        apiSchemas = ["RigExecMoverAPI"]
    )
    {
        uniform token rigExec:weightBlend = "radial"
    }

    def RigExecMatrixMover "Deform_CheekR_Weighted" (
        apiSchemas = ["RigExecMoverAPI"]
    )
    {
        uniform token rigExec:weightBlend = "radial"
    }

    def RigExecMatrixMover "Deform_CheekL_Weighted" (
        apiSchemas = ["RigExecMoverAPI"]
    )
    {
        uniform token rigExec:weightBlend = "radial"
    }

    def RigExecMatrixMover "Deform_Nose_Weighted" (
        apiSchemas = ["RigExecMoverAPI"]
    )
    {
        uniform token rigExec:weightBlend = "radial"
    }

