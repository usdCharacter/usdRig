#usda 1.0
(
    defaultPrim = "Component"
    doc = "Reusable leg rig definitions. Bind with component.json and character fit data."
)

def Scope "Component"
{
    def RigExecControl "Control_HipRoot" (
        apiSchemas = ["RigExecControlAPI"]
        doc = "Where the leg's IK chain starts."
    )
    {
        uniform token guide:planeNormal = "Y"
        uniform token guide:shape = "circle"
    }

    def RigExecControl "Control_FootIK" (
        apiSchemas = ["RigExecControlAPI"]
        doc = "IK foot: moves and turns the foot about the ankle (world axes); the leg follows."
    )
    {
        double avars:rx = 0
        double avars:ry = 0
        double avars:rz = 0
        double avars:tx = 0
        double avars:ty = 0
        double avars:tz = 0
        uniform token guide:planeNormal = "Y"
        uniform token guide:shape = "box"
    }

    def RigExecControl "Control_KneePole" (
        apiSchemas = ["RigExecControlAPI"]
        doc = "Pole: the knee points toward it."
    )
    {
        double avars:tx = 0
        double avars:ty = 0
        double avars:tz = 0
        uniform token guide:shape = "diamond"
    }

    def RigExecJoint "Joint_LegUpper"
    {
    }

    def RigExecJoint "Joint_LegLower"
    {
    }

    def RigExecJoint "Joint_Foot"
    {
    }

    def RigExecTwoBoneIk "Solver_LegIK"
    {
        float inputs:softness = 0
        float inputs:stretch = 0
    }

    def RigExecStaticWeight "Weight"
    {
        uniform float rigExec:defaultWeight = 0
        uniform token rigExec:representation = "sparse"
    }

    def RigExecMatrixMover "Deform_LegUpper_Weighted" (
        apiSchemas = ["RigExecMoverAPI"]
    )
    {
        uniform token rigExec:weightBlend = "radial"
    }

    def RigExecMatrixMover "Deform_LegLower_Weighted" (
        apiSchemas = ["RigExecMoverAPI"]
    )
    {
        uniform token rigExec:weightBlend = "radial"
    }

    def RigExecMatrixMover "Deform_Foot_Weighted" (
        apiSchemas = ["RigExecMoverAPI"]
    )
    {
        uniform token rigExec:weightBlend = "radial"
    }

    def RigExecMatrixMover "Deform_Foot_Absolute" (
        apiSchemas = ["RigExecMoverAPI"]
    )
    {
        uniform token rigExec:weightBlend = "radial"
    }
}

