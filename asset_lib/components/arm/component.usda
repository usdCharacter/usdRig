#usda 1.0
(
    defaultPrim = "Component"
    doc = "Reusable arm rig definitions. Bind with component.json and character fit data."
)

def Scope "Component"
{
    def RigExecControl "Control_Clavicle" (
        apiSchemas = ["RigExecControlAPI"]
        doc = "The shoulder: +rz shrugs it up."
    )
    {
        double avars:rx = 0
        double avars:ry = 0
        double avars:rz = 0
        uniform token guide:planeNormal = "X"
        uniform token guide:shape = "circle"
    }

    def RigExecControl "Control_ShoulderRoot" (
        apiSchemas = ["RigExecControlAPI"]
        doc = "Where the arm's IK chain starts."
    )
    {
        uniform token guide:planeNormal = "Y"
        uniform token guide:shape = "circle"
    }

    def RigExecControl "Control_HandIK" (
        apiSchemas = ["RigExecControlAPI"]
        doc = "IK hand: moves and turns the hand (world axes); the arm follows."
    )
    {
        double avars:rx = 0
        double avars:ry = 0
        double avars:rz = 0
        double avars:tx = 0
        double avars:ty = 0
        double avars:tz = 0
        uniform token guide:shape = "cube"
    }

    def RigExecControl "Control_ElbowPole" (
        apiSchemas = ["RigExecControlAPI"]
        doc = "Pole: the elbow points toward it."
    )
    {
        double avars:tx = 0
        double avars:ty = 0
        double avars:tz = 0
        uniform token guide:shape = "diamond"
    }

    def RigExecControl "Control_Hand" (
        apiSchemas = ["RigExecControlAPI"]
