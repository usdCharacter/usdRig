            def Points "jawRight"
            {
                point3f[] points = [(0.25, 0.52235293, 0), (0.2740767, 0.5319332, 0), (0.29857954, 0.5380986, 0), (0.32350853, 0.54288274, 0), (0.34886363, 0.54661006, 0), (0.37464488, 0.54942054, 0), (0.40085226, 0.5513882, 0), (0.4274858, 0.5525546, 0), (0.45454547, 0.5529412, 0), (0.48203126, 0.5525546, 0), (0.5099432, 0.5513882, 0), (0.53828126, 0.54942054, 0), (0.56704545, 0.54661006, 0), (0.5962358, 0.54288274, 0), (0.6258523, 0.5380986, 0), (0.6558949, 0.5319332, 0), (0.68636364, 0.52235293, 0), (0.25, 0.52235293, 0), (0.2740767, 0.51013714, 0), (0.29857954, 0.5032907, 0), (0.32350853, 0.49825478, 0), (0.34886363, 0.4944618, 0), (0.37464488, 0.49166667, 0), (0.40085226, 0.48973975, 0), (0.4274858, 0.48860848, 0), (0.45454547, 0.4882353, 0), (0.48203126, 0.48860848, 0), (0.5099432, 0.48973975, 0), (0.53828126, 0.49166667, 0), (0.56704545, 0.4944618, 0), (0.5962358, 0.49825478, 0), (0.6258523, 0.5032907, 0), (0.6558949, 0.51013714, 0), (0.68636364, 0.52235293, 0)]
