#usda 1.0
(
    """
    RigExec example 12 - a curve stuck to a NURBS patch.

    An 8-point linear BasisCurves rides a sculpted 4x4 bicubic NURBS patch
    through a single RigExecPatchMover: each curve point lands on the surface
    at the (u, v) coordinate carried by the matching point of an invisible
    Points carrier. The carrier's points animate through native timeSamples,
    read at the base phase, so the curve roams over the bump with no other
    operator in the rig; the compiler maintains the curve's authored extent
    automatically.
    Patch points run u-fastest (rows of constant v).
    """
    defaultPrim = "PatchAsset"
    endTimeCode = 1048
    metersPerUnit = 0.01
    startTimeCode = 1001
    timeCodesPerSecond = 24
    upAxis = "Y"
)

def Xform "PatchAsset"
{
    def RigExecRoot "Rig"
    {
        uniform token rigExec:partition = "PatchAsset"

        def Scope "Movers"
        {
            def Scope "Geometry"
            {
                def RigExecPatchMover "StickCurve" (
                    prepend apiSchemas = ["RigExecMoverAPI", "NodeGraphNodeAPI"]
                )
                {
                    rel rigExec:moves = </PatchAsset/Geom/StuckCurve.points>
                    rel rigExec:patch = </PatchAsset/Geom/Sail>
                    rel rigExec:uvPoints = </PatchAsset/Geom/CurveUVs>
                    uniform asset ui:nodegraph:node:icon = @../icons/surface_mover.png@
                }
            }
        }
    }

    def Scope "Geom"
    {
        def NurbsPatch "Sail"
        {
            float3[] extent = [(-3, 0, -3), (3, 1.6, 3)]
            point3f[] points = [(-3, 0, -3), (-1, 0.4, -3), (1, 0.4, -3), (3, 0, -3), (-3, 0.4, -1), (-1, 1.6, -1), (1, 1.6, -1), (3, 0.4, -1), (-3, 0.4, 1), (-1, 1.6, 1), (1, 1.6, 1), (3, 0.4, 1), (-3, 0, 3), (-1, 0.4, 3), (1, 0.4, 3), (3, 0, 3)]
            uniform token uForm = "open"
            double[] uKnots = [0, 0, 0, 0, 1, 1, 1, 1]
            int uOrder = 4
            int uVertexCount = 4
            uniform token vForm = "open"
            double[] vKnots = [0, 0, 0, 0, 1, 1, 1, 1]
            int vOrder = 4
            int vVertexCount = 4
        }

        def Points "CurveUVs"
        {
            point3f[] points = [(0.1, 0.5, 0), (0.2, 0.5, 0), (0.3, 0.5, 0), (0.4, 0.5, 0), (0.5, 0.5, 0), (0.6, 0.5, 0), (0.7, 0.5, 0), (0.8, 0.5, 0)]
            point3f[] points.timeSamples = {
                1001: [(0.1, 0.5, 0), (0.2, 0.5, 0), (0.3, 0.5, 0), (0.4, 0.5, 0), (0.5, 0.5, 0), (0.6, 0.5, 0), (0.7, 0.5, 0), (0.8, 0.5, 0)],
                1024: [(0.25, 0.75, 0), (0.35, 0.75, 0), (0.45, 0.75, 0), (0.55, 0.75, 0), (0.65, 0.75, 0), (0.75, 0.75, 0), (0.85, 0.75, 0), (0.95, 0.75, 0)],
                1048: [(0.05, 0.25, 0), (0.15, 0.25, 0), (0.25, 0.25, 0), (0.35, 0.25, 0), (0.45, 0.25, 0), (0.55, 0.25, 0), (0.65, 0.25, 0), (0.75, 0.25, 0)],
            }
            token visibility = "invisible"
            float[] widths = [0.05, 0.05, 0.05, 0.05, 0.05, 0.05, 0.05, 0.05] (
                interpolation = "vertex"
            )
        }

        def BasisCurves "StuckCurve"
        {
            int[] curveVertexCounts = [8]
            float3[] extent = [(-2.9, -0.1, -1.7), (2.9, 1.3, 1.7)]
            point3f[] points = [(-2.4, 0.57, 0), (-1.8, 0.78, 0), (-1.2, 0.93, 0), (-0.6, 1.02, 0), (0, 1.05, 0), (0.6, 1.02, 0), (1.2, 0.93, 0), (1.8, 0.78, 0)]
            uniform token type = "linear"
            float[] widths = [0.08, 0.08, 0.08, 0.08, 0.08, 0.08, 0.08, 0.08] (
                interpolation = "vertex"
            )
            uniform token wrap = "nonperiodic"
        }
    }
}
