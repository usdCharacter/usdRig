            int[] faceVertexCounts = [4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4]
            int[] faceVertexIndices = [0, 25, 26, 1, 1, 26, 27, 2, 2, 27, 28, 3, 3, 28, 29, 4, 4, 29, 30, 5, 5, 30, 31, 6, 6, 31, 32, 7, 7, 32, 33, 8, 8, 33, 34, 9, 9, 34, 35, 10, 10, 35, 36, 11, 11, 36, 37, 12, 12, 37, 38, 13, 13, 38, 39, 14, 14, 39, 40, 15, 15, 40, 41, 16, 16, 41, 42, 17, 17, 42, 43, 18, 18, 43, 44, 19, 19, 44, 45, 20, 20, 45, 46, 21, 21, 46, 47, 22, 22, 47, 48, 23, 23, 48, 49, 24]
