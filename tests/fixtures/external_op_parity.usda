                rel rigExec:moves = </ExternalAsset/Geom/Strip.points>
                uniform token rigExec:skinningMethod = "classicLinear"
            }

            def RigExecSmoothMover "RibbonRelax" (
                prepend apiSchemas = ["RigExecMoverAPI"]
            )
            {
                float inputs:defaultWeight = 0.5
                rel rigExec:moves = </ExternalAsset/Geom/Ribbon.points>
            }

            def RigExecLayeredSkinMover "RibbonLayer" (
