# Writes the generated probe translation unit. The witness compiles its
# output from a build-directory component named like a vendored tree, so a
# path-text exemption would wrongly cover the owned targets that compile
# it; only an ownership marker may exempt.
if (NOT DEFINED OUT)
    message(FATAL_ERROR "genSource.cmake: set OUT")
endif ()
file(WRITE "${OUT}"
"// Generated by genSource.cmake; volatile operands keep the probe out of
// the compiler's constant folding in every floating-point mode.
#include <cstdio>
#include <cstring>

void rigexecPrintGeneratedProbe()
{
    volatile float a = 1.5f;
    volatile float b = 0.14999999f;
    volatile float c = 0.14999999f;
    float contract = a * b + c;
    unsigned u = 0;
    std::memcpy(&u, &contract, sizeof(u));
    std::printf(\"generated contract %08x\\n\", u);
}
")
